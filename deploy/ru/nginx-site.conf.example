# Include this inside the HTTPS server block after configuring the real domain,
# certificate and an RU-based origin. Confirm that logs and backups stay in Russia.
# Build with NEXT_PUBLIC_BASE_PATH="" so the static export works at the domain root.
root /srv/www/vshokolade/current;
index index.html;
autoindex off;
server_tokens off;
gzip on;
gzip_vary on;
gzip_min_length 1024;
gzip_types text/css application/javascript application/json image/svg+xml;

add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'none'; script-src 'self' 'unsafe-inline'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://yandex.ru https://www.yandex.ru; worker-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests" always;
add_header Referrer-Policy "no-referrer" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=()" always;
add_header Strict-Transport-Security "max-age=31536000" always;

location / {
    try_files $uri $uri/ =404;
}

location /_next/static/ {
    expires 1y;
    try_files $uri =404;
}

location ~ /\.(?!well-known/) {
    deny all;
}

error_page 404 /404.html;

# The static Next export still contains inline hydration scripts. For now
# script-src requires 'unsafe-inline'; replace it with a validated hash/nonce
# strategy before claiming a strict CSP. If Metrica is enabled later, review
# its domains and update this header and the privacy notice before deployment.
